{
  "name": "@shop/users",
  "version": "1.0.0",
  "private": true,
  "description": "회원 서비스 (NestJS + Prisma): 회원가입, 로그인 JWT 발급, 내 정보 조회",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
