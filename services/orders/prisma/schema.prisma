generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("ORDERS_DB_URL")
}

/// status 는 DB CHECK (status IN ('PENDING_PAYMENT','PAID_TEST','FAILED','CANCELLED','EXPIRED')) 로 제한됩니다.
/// reservation_status 는 DB CHECK (reservation_status IN ('RESERVED','CONFIRMED','RELEASED')) 로 제한됩니다.
/// id 는 orders 서비스가 randomUUID() 로 미리 만들어 넣습니다.
model Order {
  id                String      @id @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  idempotencyKey    String      @map("idempotency_key")
  status            String
  totalAmount       Int         @map("total_amount")
  currency          String      @default("KRW")
  reservationId     String      @map("reservation_id") @db.Uuid
  reservationStatus String      @map("reservation_status")
  paymentId         String?     @unique @map("payment_id")
  failureReason     String?     @map("failure_reason")
  paidAt            DateTime?   @map("paid_at") @db.Timestamptz(6)
  shipRecipient     String      @default("") @map("ship_recipient")
  shipPhone         String      @default("") @map("ship_phone")
  shipZipcode       String      @default("") @map("ship_zipcode")
  shipAddress1      String      @default("") @map("ship_address1")
  shipAddress2      String      @default("") @map("ship_address2")
  shipMemo          String      @default("") @map("ship_memo")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items             OrderItem[]

  @@unique([userId, idempotencyKey], map: "orders_user_id_idempotency_key_key")
  @@index([userId], map: "orders_user_id_idx")
  @@index([status, createdAt], map: "orders_status_created_at_idx")
  @@map("orders")
}

/// quantity 는 DB CHECK (quantity > 0) 로 제한됩니다.
model OrderItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String @map("order_id") @db.Uuid
  productId   String @map("product_id") @db.Uuid
  productName String @map("product_name")
  unitPrice   Int    @map("unit_price")
  quantity    Int
  lineTotal   Int    @map("line_total")
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "order_items_order_id_idx")
  @@map("order_items")
}
